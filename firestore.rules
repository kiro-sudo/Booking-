rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'zwalpyaes@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (synchronized with firebase-blueprint.json)
    // -------------------------------------------------------------------------
    function isValidTravelDate(data) {
      return data.keys().hasAll(['date', 'label', 'capacity', 'bookedCount', 'isOpen', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'label', 'capacity', 'bookedCount', 'isOpen', 'createdAt', 'updatedAt'])
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.label is string
        && data.label.size() >= 3
        && data.label.size() <= 64
        && data.capacity is int
        && data.capacity >= 1
        && data.capacity <= 10000
        && data.bookedCount is int
        && data.bookedCount >= 0
        && data.bookedCount <= data.capacity
        && data.isOpen is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCounter(data) {
      return data.keys().hasAll(['lastNumber', 'lastBookingId', 'updatedAt'])
        && data.keys().hasOnly(['lastNumber', 'lastBookingId', 'updatedAt'])
        && data.lastNumber is int
        && data.lastNumber >= 0
        && data.lastBookingId is string
        && data.lastBookingId.size() >= 4
        && data.lastBookingId.size() <= 128
        && data.lastBookingId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.updatedAt is timestamp;
    }

    function isValidPhoneLock(data) {
      return data.keys().hasAll(['bookingId', 'bookingNumber', 'nameHash', 'createdAt'])
        && data.keys().hasOnly(['bookingId', 'bookingNumber', 'nameHash', 'createdAt'])
        && data.bookingId is string
        && data.bookingId.size() == 64
        && data.bookingId.matches('^[a-f0-9]{64}$')
        && data.bookingNumber is string
        && data.bookingNumber.size() >= 4
        && data.bookingNumber.size() <= 32
        && data.bookingNumber.matches('^BT-[1-9][0-9]*$')
        && data.nameHash is string
        && data.nameHash.size() == 64
        && data.nameHash.matches('^[a-f0-9]{64}$')
        && data.createdAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'bookingNumber', 'customerName', 'normalizedName', 'phone',
          'normalizedPhone', 'phoneHash', 'travelDateId', 'travelDateLabel',
          'status', 'tripName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'bookingNumber', 'customerName', 'normalizedName', 'phone',
          'normalizedPhone', 'phoneHash', 'datePhoneHash', 'travelDateId', 'travelDateLabel',
          'status', 'tripName', 'createdAt', 'cancelledAt'
        ])
        && data.bookingNumber is string
        && data.bookingNumber.size() >= 4
        && data.bookingNumber.size() <= 32
        && data.bookingNumber.matches('^BT-[1-9][0-9]*$')
        && data.customerName is string
        && data.customerName.size() >= 2
        && data.customerName.size() <= 120
        && data.normalizedName is string
        && data.normalizedName.size() >= 2
        && data.normalizedName.size() <= 120
        && data.phone is string
        && data.phone.size() >= 6
        && data.phone.size() <= 30
        && data.normalizedPhone is string
        && data.normalizedPhone.size() >= 6
        && data.normalizedPhone.size() <= 24
        && data.normalizedPhone.matches('^[0-9+]{6,24}$')
        && data.phoneHash is string
        && data.phoneHash.size() == 64
        && data.phoneHash.matches('^[a-f0-9]{64}$')
        && (!('datePhoneHash' in data) || (
          data.datePhoneHash is string
          && data.datePhoneHash.size() == 64
          && data.datePhoneHash.matches('^[a-f0-9]{64}$')
        ))
        && data.travelDateId is string
        && data.travelDateId.size() >= 3
        && data.travelDateId.size() <= 64
        && data.travelDateId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.travelDateLabel is string
        && data.travelDateLabel.size() >= 3
        && data.travelDateLabel.size() <= 64
        && (!('cancelledAt' in data) || data.cancelledAt is timestamp)
        && data.status is string
        && (data.status == 'Confirmed' || data.status == 'Cancelled')
        && data.tripName is string
        && data.tripName.size() >= 2
        && data.tripName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 160
        && data.role is string
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidContactSettings(data) {
      return data.keys().hasAll(['adminPhone', 'telegramInput', 'updatedAt'])
        && data.keys().hasOnly(['adminPhone', 'telegramInput', 'updatedAt'])
        && data.adminPhone is string
        && data.adminPhone.size() <= 32
        && (data.adminPhone.size() == 0 || data.adminPhone.matches('^[0-9+\\-\\s().]{6,32}$'))
        && data.telegramInput is string
        && data.telegramInput.size() <= 160
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // Connection check endpoint (no PII)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Public departure schedule (non-PII availability only)
    match /travelDates/{dateId} {
      allow get: if isValidId(dateId);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(dateId)
        && isValidTravelDate(incoming())
        && incoming().bookedCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(dateId) && isValidTravelDate(incoming()) && (
        // Action 1: Admin modifies date, label, capacity (>= bookedCount), or open status
        (
          isAdmin()
          && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'label', 'capacity', 'isOpen', 'updatedAt'])
          && incoming().createdAt == existing().createdAt
          && incoming().bookedCount == existing().bookedCount
          && incoming().capacity >= existing().bookedCount
          && incoming().updatedAt == request.time
        ) ||
        // Action 2: Atomic booking capacity increment paired with per-date counter increment
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['bookedCount', 'updatedAt'])
          && existing().isOpen == true
          && incoming().bookedCount == existing().bookedCount + 1
          && incoming().bookedCount <= existing().capacity
          && incoming().updatedAt == request.time
          && getAfter(/databases/$(database)/documents/dateCounters/$(dateId)).data.lastBookingId != 'INIT'
          && (
            (
              !exists(/databases/$(database)/documents/dateCounters/$(dateId))
              && getAfter(/databases/$(database)/documents/dateCounters/$(dateId)).data.lastNumber == 1
            ) || (
              exists(/databases/$(database)/documents/dateCounters/$(dateId))
              && getAfter(/databases/$(database)/documents/dateCounters/$(dateId)).data.lastNumber
                 == get(/databases/$(database)/documents/dateCounters/$(dateId)).data.lastNumber + 1
            )
          )
        ) ||
        // Action 3: Admin booking cancellation decrement
        (
          isAdmin()
          && incoming().diff(existing()).affectedKeys().hasOnly(['bookedCount', 'updatedAt'])
          && existing().bookedCount >= 1
          && incoming().bookedCount == existing().bookedCount - 1
          && incoming().updatedAt == request.time
        )
      );

      allow delete: if isAdmin()
        && isValidId(dateId)
        && existing().bookedCount == 0;
    }

    // Legacy global counter (read-only/frozen)
    match /counters/{counterId} {
      allow get: if isValidId(counterId) && counterId == 'booking';
      allow list, write: if false;
    }

    // Per-travel-date monotonic booking sequence counters (BT-1, BT-2, ... per dateId; never reset)
    match /dateCounters/{dateId} {
      allow get: if isValidId(dateId);
      allow list, delete: if false;

      allow create: if isValidId(dateId)
        && isValidCounter(incoming())
        && exists(/databases/$(database)/documents/travelDates/$(dateId))
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().lastNumber == 0
            && incoming().lastBookingId == 'INIT'
          ) || (
            incoming().lastNumber == 1
            && incoming().lastBookingId != 'INIT'
            && getAfter(/databases/$(database)/documents/bookings/$(incoming().lastBookingId)).data.bookingNumber == 'BT-1'
            && getAfter(/databases/$(database)/documents/bookings/$(incoming().lastBookingId)).data.travelDateId == dateId
          )
        );

      allow update: if isValidId(dateId)
        && isValidCounter(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastNumber', 'lastBookingId', 'updatedAt'])
        && incoming().lastNumber == existing().lastNumber + 1
        && incoming().lastBookingId != 'INIT'
        && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/bookings/$(incoming().lastBookingId)).data.bookingNumber
           == 'BT-' + string(incoming().lastNumber)
        && getAfter(/databases/$(database)/documents/bookings/$(incoming().lastBookingId)).data.travelDateId
           == dateId;
    }

    // Per-date phone uniqueness locks (cryptographic SHA-256 hashes only, zero PII)
    match /phoneLocks/{phoneHash} {
      allow get: if isAdmin() || (isValidId(phoneHash) && phoneHash.size() == 64);
      allow list: if isAdmin();

      allow create: if isValidId(phoneHash)
        && phoneHash.size() == 64
        && isValidPhoneLock(incoming())
        && !exists(/databases/$(database)/documents/phoneLocks/$(phoneHash))
        && incoming().createdAt == request.time
        && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.datePhoneHash == phoneHash
        && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.bookingNumber == incoming().bookingNumber;

      allow update, delete: if isAdmin();
    }

    // Customer bookings (keyed by SHA-256(normalizedName + '|' + normalizedPhone + '|' + travelDateId))
    match /bookings/{bookingId} {
      allow get: if isAdmin() || (isValidId(bookingId) && bookingId.size() == 64);
      allow list: if isAdmin();

      allow create: if isValidId(bookingId)
        && bookingId.size() == 64
        && isValidBooking(incoming())
        && ('datePhoneHash' in incoming())
        && !('cancelledAt' in incoming())
        && incoming().createdAt == request.time
        && incoming().status == 'Confirmed'
        && exists(/databases/$(database)/documents/travelDates/$(incoming().travelDateId))
        && get(/databases/$(database)/documents/travelDates/$(incoming().travelDateId)).data.label
           == incoming().travelDateLabel
        && getAfter(/databases/$(database)/documents/dateCounters/$(incoming().travelDateId)).data.lastBookingId
           == bookingId
        && (
          (
            !exists(/databases/$(database)/documents/dateCounters/$(incoming().travelDateId))
            && getAfter(/databases/$(database)/documents/dateCounters/$(incoming().travelDateId)).data.lastNumber == 1
          ) || (
            exists(/databases/$(database)/documents/dateCounters/$(incoming().travelDateId))
            && getAfter(/databases/$(database)/documents/dateCounters/$(incoming().travelDateId)).data.lastNumber
               == get(/databases/$(database)/documents/dateCounters/$(incoming().travelDateId)).data.lastNumber + 1
          )
        )
        && incoming().bookingNumber
           == 'BT-' + string(getAfter(/databases/$(database)/documents/dateCounters/$(incoming().travelDateId)).data.lastNumber)
        && getAfter(/databases/$(database)/documents/travelDates/$(incoming().travelDateId)).data.bookedCount
           == get(/databases/$(database)/documents/travelDates/$(incoming().travelDateId)).data.bookedCount + 1
        && existsAfter(/databases/$(database)/documents/phoneLocks/$(incoming().datePhoneHash));

      allow update: if isAdmin()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().bookingNumber == existing().bookingNumber
        && incoming().createdAt == existing().createdAt
        && incoming().customerName == existing().customerName
        && incoming().normalizedName == existing().normalizedName
        && incoming().phone == existing().phone
        && incoming().normalizedPhone == existing().normalizedPhone
        && incoming().phoneHash == existing().phoneHash
        && (
          // Update A: Keep travelDateLabel synced when admin edits a travel date
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['travelDateLabel', 'travelDateId'])
            && incoming().status == existing().status
          ) ||
          // Update B: Atomic Admin cancellation (Confirmed -> Cancelled) restoring daily capacity
          (
            existing().status == 'Confirmed'
            && incoming().status == 'Cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt'])
            && incoming().cancelledAt == request.time
            && incoming().travelDateId == existing().travelDateId
            && incoming().travelDateLabel == existing().travelDateLabel
            && getAfter(/databases/$(database)/documents/travelDates/$(existing().travelDateId)).data.bookedCount
               == get(/databases/$(database)/documents/travelDates/$(existing().travelDateId)).data.bookedCount - 1
          )
        );

      // Cancelled and confirmed bookings are preserved as historical records
      allow delete: if false;
    }

    // Public customer support contact settings (Admin write only)
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'contact';
      allow list, delete: if false;
      allow create, update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'contact'
        && isValidContactSettings(incoming())
        && incoming().updatedAt == request.time;
    }

    // Admin registry
    match /admins/{uid} {
      allow get: if isAdmin() && isValidId(uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(uid);
    }
  }
}
